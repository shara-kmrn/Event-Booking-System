# Development configuration. Copy to .env and supply your own values.
# Actual .env files must remain untracked.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/event_saas

# REQUIRED. Generate a cryptographically random secret; never use a template value.
# Production requires at least 32 bytes. Changing it signs out existing sessions.
JWT_SECRET=
JWT_TTL_SECONDS=86400
JWT_ISSUER=eventra-api
JWT_AUDIENCE=eventra-web

# Exact comma-separated origins (no trailing slash/path/wildcards).
# Production requires HTTPS. CLIENT_URL is also used by existing redirects.
CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave 0 without a reverse proxy. Set only to your actual trusted proxy hop count.
TRUST_PROXY_HOPS=0

# OTP delivery is SMTP-only, including development; no console/API OTP fallback.
# Use a local SMTP mail catcher in development if desired.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
FROM_EMAIL=
# Configure both credentials, or leave both empty for an unauthenticated relay.
SMTP_USER=
SMTP_PASS=

AUTH_OTP_TTL_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_SENDS_PER_HOUR=5
# MongoDB-backed endpoint/account limits; per-IP ceiling is four times the limit.
AUTH_RATE_WINDOW_SECONDS=900
AUTH_RATE_LOGIN_MAX=15
AUTH_RATE_VERIFY_MAX=10
AUTH_RATE_SEND_MAX=3

# REQUIRED for paid/free Checkout booking flows; production startup validates presence.
# Use Stripe TEST mode during development and the matching CLI/endpoint signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Single-document inventory journal works with standalone MongoDB and replica sets.
BOOKING_RESERVATION_MINUTES=30
BOOKING_MAX_TICKETS=100
BOOKING_JOURNAL_LIMIT=5000
BOOKING_MAINTENANCE_SECONDS=30
# Offset used only for newly created legacy date+clock schedules; explicit ISO datetimes must include Z or an offset.
EVENT_TIMEZONE_OFFSET_MINUTES=330
